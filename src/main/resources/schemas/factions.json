{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MfFactions",
  "description": "Schema for Medieval Factions faction data. Mirrors the JsonFactionDto serialization shape. Nullable fields (prefix, home) are omitted entirely by Gson when null, so they are not required.",
  "type": "object",
  "properties": {
    "factions": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/faction"
      }
    }
  },
  "required": ["factions"],
  "definitions": {
    "faction": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique faction identifier"
        },
        "version": {
          "type": "integer",
          "minimum": 0,
          "description": "Version for optimistic locking"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Faction name"
        },
        "description": {
          "type": "string",
          "description": "Faction description"
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/member"
          }
        },
        "invites": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/playerRef"
          }
        },
        "flags": {
          "type": "object",
          "description": "Faction flag values, keyed by flag name"
        },
        "prefix": {
          "type": ["string", "null"],
          "description": "Faction prefix"
        },
        "home": {
          "oneOf": [
            {
              "$ref": "#/definitions/position"
            },
            {
              "type": "null"
            }
          ],
          "description": "Faction home location"
        },
        "bonusPower": {
          "type": "number",
          "description": "Bonus power for the faction"
        },
        "autoclaim": {
          "type": "boolean",
          "description": "Whether autoclaim is enabled"
        },
        "roles": {
          "$ref": "#/definitions/roles"
        },
        "defaultPermissionsByName": {
          "type": "object",
          "description": "Default permission values, keyed by permission name",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "applications": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/playerRef"
          }
        }
      },
      "required": [
        "id",
        "version",
        "name",
        "description",
        "members",
        "invites",
        "flags",
        "bonusPower",
        "autoclaim",
        "roles",
        "defaultPermissionsByName",
        "applications"
      ],
      "additionalProperties": false
    },
    "member": {
      "type": "object",
      "properties": {
        "playerId": {
          "type": "string",
          "minLength": 1
        },
        "roleId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["playerId", "roleId"],
      "additionalProperties": false
    },
    "playerRef": {
      "type": "object",
      "properties": {
        "playerId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["playerId"],
      "additionalProperties": false
    },
    "roles": {
      "type": "object",
      "properties": {
        "defaultRoleId": {
          "type": "string",
          "minLength": 1
        },
        "roles": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/role"
          }
        }
      },
      "required": ["defaultRoleId", "roles"],
      "additionalProperties": false
    },
    "role": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "permissionsByName": {
          "type": "object",
          "description": "Permission values for this role, keyed by permission name",
          "additionalProperties": {
            "type": ["boolean", "null"]
          }
        }
      },
      "required": ["id", "name", "permissionsByName"],
      "additionalProperties": false
    },
    "position": {
      "type": "object",
      "properties": {
        "worldId": {
          "type": "string",
          "minLength": 1
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        },
        "yaw": {
          "type": "number"
        },
        "pitch": {
          "type": "number"
        }
      },
      "required": ["worldId", "x", "y", "z", "yaw", "pitch"],
      "additionalProperties": false
    }
  }
}
